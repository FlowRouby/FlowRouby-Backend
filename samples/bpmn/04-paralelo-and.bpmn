<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_ParaleloAnd" targetNamespace="http://flowrouby.dev/samples">
  <bpmn:process id="Process_ParaleloAnd" name="Preparación de pedido" isExecutable="true">
    <bpmn:startEvent id="Start_Pedido" name="Pedido confirmado">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Dividir" name="">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Facturar" name="Generar factura">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Empacar" name="Empacar productos">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Unir" name="">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Despachar" name="Despachar pedido">
      <bpmn:incoming>Flow_P6</bpmn:incoming>
      <bpmn:outgoing>Flow_P7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Pedido" name="Pedido despachado">
      <bpmn:incoming>Flow_P7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Pedido" targetRef="Gateway_Dividir" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Gateway_Dividir" targetRef="Task_Facturar" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Gateway_Dividir" targetRef="Task_Empacar" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_Facturar" targetRef="Gateway_Unir" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_Empacar" targetRef="Gateway_Unir" />
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Gateway_Unir" targetRef="Task_Despachar" />
    <bpmn:sequenceFlow id="Flow_P7" sourceRef="Task_Despachar" targetRef="End_Pedido" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_ParaleloAnd">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_ParaleloAnd" bpmnElement="Process_ParaleloAnd">
      <bpmndi:BPMNShape id="Start_Pedido_di" bpmnElement="Start_Pedido">
        <dc:Bounds x="182" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Dividir_di" bpmnElement="Gateway_Dividir">
        <dc:Bounds x="295" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Facturar_di" bpmnElement="Task_Facturar">
        <dc:Bounds x="420" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Empacar_di" bpmnElement="Task_Empacar">
        <dc:Bounds x="420" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Unir_di" bpmnElement="Gateway_Unir">
        <dc:Bounds x="595" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Despachar_di" bpmnElement="Task_Despachar">
        <dc:Bounds x="710" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Pedido_di" bpmnElement="End_Pedido">
        <dc:Bounds x="882" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_P1_di" bpmnElement="Flow_P1">
        <di:waypoint x="218" y="200" />
        <di:waypoint x="295" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2_di" bpmnElement="Flow_P2">
        <di:waypoint x="320" y="175" />
        <di:waypoint x="320" y="120" />
        <di:waypoint x="420" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P3_di" bpmnElement="Flow_P3">
        <di:waypoint x="320" y="225" />
        <di:waypoint x="320" y="280" />
        <di:waypoint x="420" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P4_di" bpmnElement="Flow_P4">
        <di:waypoint x="520" y="120" />
        <di:waypoint x="620" y="120" />
        <di:waypoint x="620" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P5_di" bpmnElement="Flow_P5">
        <di:waypoint x="520" y="280" />
        <di:waypoint x="620" y="280" />
        <di:waypoint x="620" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P6_di" bpmnElement="Flow_P6">
        <di:waypoint x="645" y="200" />
        <di:waypoint x="710" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P7_di" bpmnElement="Flow_P7">
        <di:waypoint x="810" y="200" />
        <di:waypoint x="882" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
