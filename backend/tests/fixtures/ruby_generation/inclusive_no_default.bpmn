<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs" targetNamespace="http://flowrouby.dev/fixtures">
  <bpmn:process id="Process_InclusiveND" name="Inclusive without default" isExecutable="true">
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:userTask id="T0" name="Choose"><bpmn:extensionElements><camunda:formData><camunda:formField id="a" label="A" type="boolean" /><camunda:formField id="b" label="B" type="boolean" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:inclusiveGateway id="Split" name="Pick" />
    <bpmn:endEvent id="E1" name="End A" />
    <bpmn:endEvent id="E2" name="End B" />
    <bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="T0" />
    <bpmn:sequenceFlow id="f1" sourceRef="T0" targetRef="Split" />
    <bpmn:sequenceFlow id="c1" sourceRef="Split" targetRef="E1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${a == true}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="c2" sourceRef="Split" targetRef="E2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${b == true}</bpmn:conditionExpression></bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
