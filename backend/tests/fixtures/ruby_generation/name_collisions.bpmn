<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs" targetNamespace="http://flowrouby.dev/fixtures">
  <bpmn:process id="Process_Colision" name="Colisiones y acentos" isExecutable="true">
    <bpmn:startEvent id="S" name="Inicio" />
    <bpmn:userTask id="U1" name="Cotización ¡Rápida!"><bpmn:extensionElements><camunda:formData><camunda:formField id="a" label="A" type="string" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:userTask id="U2" name="Cotizacion rapida"><bpmn:extensionElements><camunda:formData><camunda:formField id="b" label="B" type="string" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:userTask id="U3" name="COTIZACIÓN-RÁPIDA"><bpmn:extensionElements><camunda:formData><camunda:formField id="c" label="C" type="string" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:userTask id="U4" name="Paso 2 de 10"><bpmn:extensionElements><camunda:formData><camunda:formField id="d" label="D" type="string" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:serviceTask id="H1" name="Enviar correo"><bpmn:extensionElements><camunda:connector><camunda:connectorId>http-connector</camunda:connectorId><camunda:inputOutput><camunda:inputParameter name="method">POST</camunda:inputParameter><camunda:inputParameter name="url">https://api.example.com/m1</camunda:inputParameter><camunda:inputParameter name="payload">{"to": "${a}"}</camunda:inputParameter></camunda:inputOutput></camunda:connector></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="H2" name="Enviar  Correo!"><bpmn:extensionElements><camunda:connector><camunda:connectorId>http-connector</camunda:connectorId><camunda:inputOutput><camunda:inputParameter name="method">POST</camunda:inputParameter><camunda:inputParameter name="url">https://api.example.com/m2</camunda:inputParameter><camunda:inputParameter name="payload">{"to": "${b}"}</camunda:inputParameter></camunda:inputOutput></camunda:connector></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="D1" name="Delegar uno" camunda:class="com.acme.Calculadora" />
    <bpmn:serviceTask id="D2" name="Delegar dos" camunda:class="org.other.Calculadora" />
    <bpmn:businessRuleTask id="R1" name="Regla uno" camunda:decisionRef="Riesgo Crédito" camunda:resultVariable="r1" />
    <bpmn:businessRuleTask id="R2" name="Regla dos" camunda:decisionRef="riesgo credito" />
    <bpmn:serviceTask id="Sym" name="???" />
    <bpmn:callActivity id="Cx" name="Llamar" calledElement="sub-proceso común" />
    <bpmn:endEvent id="E" name="Fin" />
    <bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="U1" />
    <bpmn:sequenceFlow id="f1" sourceRef="U1" targetRef="U2" />
    <bpmn:sequenceFlow id="f2" sourceRef="U2" targetRef="U3" />
    <bpmn:sequenceFlow id="f3" sourceRef="U3" targetRef="U4" />
    <bpmn:sequenceFlow id="f4" sourceRef="U4" targetRef="H1" />
    <bpmn:sequenceFlow id="f5" sourceRef="H1" targetRef="H2" />
    <bpmn:sequenceFlow id="f6" sourceRef="H2" targetRef="D1" />
    <bpmn:sequenceFlow id="f7" sourceRef="D1" targetRef="D2" />
    <bpmn:sequenceFlow id="f8" sourceRef="D2" targetRef="R1" />
    <bpmn:sequenceFlow id="f9" sourceRef="R1" targetRef="R2" />
    <bpmn:sequenceFlow id="f10" sourceRef="R2" targetRef="Sym" />
    <bpmn:sequenceFlow id="f11" sourceRef="Sym" targetRef="Cx" />
    <bpmn:sequenceFlow id="f12" sourceRef="Cx" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
