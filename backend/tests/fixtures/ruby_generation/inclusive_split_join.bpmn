<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs" targetNamespace="http://flowrouby.dev/fixtures">
  <bpmn:process id="Process_Inclusive" name="Inclusive split and join" isExecutable="true">
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:userTask id="T0" name="Choose channels"><bpmn:extensionElements><camunda:formData><camunda:formField id="email" label="Email" type="boolean" /><camunda:formField id="sms" label="SMS" type="boolean" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:inclusiveGateway id="Split" name="Which channels" default="d" />
    <bpmn:serviceTask id="Mail" name="Send email" />
    <bpmn:serviceTask id="Sms" name="Send SMS" />
    <bpmn:serviceTask id="Log" name="Write log" />
    <bpmn:serviceTask id="Fallback" name="Fallback" />
    <bpmn:inclusiveGateway id="Join" name="Merge channels" />
    <bpmn:endEvent id="E" name="Done" />
    <bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="T0" />
    <bpmn:sequenceFlow id="f1" sourceRef="T0" targetRef="Split" />
    <bpmn:sequenceFlow id="c1" sourceRef="Split" targetRef="Mail"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${email == true}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="c2" sourceRef="Split" targetRef="Sms"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sms == true}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="u" sourceRef="Split" targetRef="Log" />
    <bpmn:sequenceFlow id="d" sourceRef="Split" targetRef="Fallback" />
    <bpmn:sequenceFlow id="j1" sourceRef="Mail" targetRef="Join" />
    <bpmn:sequenceFlow id="j2" sourceRef="Sms" targetRef="Join" />
    <bpmn:sequenceFlow id="j3" sourceRef="Log" targetRef="Join" />
    <bpmn:sequenceFlow id="j4" sourceRef="Fallback" targetRef="Join" />
    <bpmn:sequenceFlow id="j5" sourceRef="Join" targetRef="E" />
  </bpmn:process>
</bpmn:definitions>
