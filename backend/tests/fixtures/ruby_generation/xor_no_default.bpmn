<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs" targetNamespace="http://flowrouby.dev/fixtures">
  <bpmn:process id="Process_NoDefault" name="Decision without default" isExecutable="true">
    <bpmn:startEvent id="S" name="Start" />
    <bpmn:userTask id="T0" name="Pick"><bpmn:extensionElements><camunda:formData><camunda:formField id="kind" label="Kind" type="string" /><camunda:formField id="level" label="Level" type="long" /></camunda:formData></bpmn:extensionElements></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw" name="Kind?" />
    <bpmn:endEvent id="E1" name="End one" />
    <bpmn:endEvent id="E2" name="End two" />
    <bpmn:endEvent id="E3" name="End three" />
    <bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="T0" />
    <bpmn:sequenceFlow id="f1" sourceRef="T0" targetRef="Gw" />
    <bpmn:sequenceFlow id="c1" sourceRef="Gw" targetRef="E1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kind == "a\b"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="c2" sourceRef="Gw" targetRef="E2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${level != 3 || level &lt; 1}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="c3" sourceRef="Gw" targetRef="E3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kind == "x" &amp;&amp; level &gt; 2}</bpmn:conditionExpression></bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
